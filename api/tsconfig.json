{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"],
    "noImplicitAny": false
  },
  "include": ["./**/*", "../artifacts/api-server/src/**/*", "../lib/**/*"]
}
